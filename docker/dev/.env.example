# Docker Dev - copy to .env and adjust as needed
# Host port (binds to 127.0.0.1 only); container listens on 10001
WEB_PORT=10100

# Optional: local image tag (see apps/web/Dockerfile target `dev`)
# DEV_WEB_IMAGE=web-monorepo-web-dev:latest

# Optional: API URL for app (if using external backend)
# NEXT_PUBLIC_API_URL=http://localhost:4000
